{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risingsea.local/schemas/domain-machine.v1.json",
  "title": "Rising Sea DomainMachine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "domain_id",
    "title",
    "representation",
    "required_observations",
    "invariants",
    "diagnostics",
    "repair_recipes",
    "verification_oracles",
    "ruin_boundaries",
    "failure_routes",
    "discovery_strategy",
    "donors"
  ],
  "properties": {
    "schema": {"const": "risingsea.domain-machine.v1"},
    "domain_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "representation": {
      "type": "object",
      "required": ["kind", "fields", "novice_projection"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "novice_projection": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "required_observations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "diagnostics": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "repair_recipes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verification_oracles": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "ruin_boundaries": {"type": "array", "items": {"type": "object"}},
    "failure_routes": {
      "type": "object",
      "required": ["UNRESOLVED"],
      "properties": {"UNRESOLVED": {"type": "object"}},
      "additionalProperties": {"type": "object"}
    },
    "discovery_strategy": {"type": "object", "minProperties": 1},
    "donors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "mechanism", "adoption", "claim_boundary"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "adoption": {"enum": ["REUSE", "ADAPT", "REFERENCE"]},
          "claim_boundary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
