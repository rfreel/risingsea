{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risingsea.obligation.schema.v1",
  "title": "Finite Obligation",
  "type": "object",
  "required": ["obligation_id", "proposition", "scope", "state", "basis_ids"],
  "properties": {
    "obligation_id": {"type": "string", "minLength": 1},
    "proposition": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "state": {"enum": ["SATISFIED", "UNSATISFIED", "CONTRADICTED", "UNKNOWN", "NOT_APPLICABLE"]},
    "basis_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
