{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risingsea.repair-recipe.schema.v1",
  "title": "Bounded Repair Recipe",
  "type": "object",
  "required": ["recipe_id", "match_verdicts", "match_rule_ids", "preconditions", "write_set", "verification_oracle_id", "strongest_falsifier", "recovery", "ruin_class", "authority_required", "authority_effect"],
  "properties": {
    "recipe_id": {"type": "string", "minLength": 1},
    "match_verdicts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "match_rule_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "write_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification_oracle_id": {"type": "string", "minLength": 1},
    "strongest_falsifier": {"type": "string", "minLength": 1},
    "recovery": {"type": "string", "minLength": 1},
    "ruin_class": {"type": "string", "minLength": 1},
    "authority_required": {"type": ["string", "null"]},
    "authority_effect": {"const": "candidate_only"}
  },
  "additionalProperties": false
}
