{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risingsea.work-packet.schema.v1",
  "title": "Frontier-Resolved WorkPacket",
  "type": "object",
  "required": ["packet_id", "history_head", "obligation_id", "objective", "basis_ids", "recipe_id", "selected_strategy", "read_set", "write_set", "verification_oracle_id", "recovery", "failure_route", "authority", "authority_effect", "execution_grammar", "reasoning_debt"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^wp:sha256:[0-9a-f]{64}$"},
    "history_head": {"type": "string", "minLength": 1},
    "obligation_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "basis_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recipe_id": {"type": "string", "minLength": 1},
    "selected_strategy": {"type": "string", "minLength": 1},
    "read_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "write_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification_oracle_id": {"type": "string", "minLength": 1},
    "recovery": {"type": "string", "minLength": 1},
    "failure_route": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "candidate_only"},
    "execution_grammar": {"const": ["READ", "CHECK", "CHANGE", "VERIFY", "RECEIPT", "STOP"]},
    "reasoning_debt": {
      "type": "object",
      "required": ["design_choice", "scope", "read_set", "write_set", "verification_oracle", "failure_route", "authority", "semantic_terms"],
      "properties": {
        "design_choice": {"const": 0},
        "scope": {"const": 0},
        "read_set": {"const": 0},
        "write_set": {"const": 0},
        "verification_oracle": {"const": 0},
        "failure_route": {"const": 0},
        "authority": {"const": 0},
        "semantic_terms": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
